# Copy this file to .env.local. Keep real credentials in .env.local only.
SARVAM_API_KEY=your_sarvam_api_key_here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Required for local testing of background video uploads. In Vercel, connect a Blob store instead.
BLOB_READ_WRITE_TOKEN=
# Optional in local development. On Vercel, VERCEL_URL is used automatically.
APP_BASE_URL=http://localhost:3000
# Only needed if the Vercel deployment uses Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional email alerts for generated dubbing jobs (Resend API).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_EMAIL=piyushkumaryadav2027@gmail.com
