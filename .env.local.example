# Copy this file to .env.local. Keep real credentials in .env.local only.
SARVAM_API_KEY=your_sarvam_api_key_here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Required for local testing of background video uploads. In Vercel, connect a Blob store instead.
BLOB_READ_WRITE_TOKEN=
# Optional in local development. On Vercel, VERCEL_URL is used automatically.
APP_BASE_URL=http://localhost:3000
# Only needed if the Vercel deployment uses Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional Gmail SMTP alerts for generated dubbing jobs. Use a Google App Password, not your account password.
GMAIL_USER=piyushkumaryadav2027@gmail.com
GMAIL_APP_PASSWORD=
# Supabase Project URL and Publishable key (Connect dialog or Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only Secret key; used by the background workflow to save job status
SUPABASE_SECRET_KEY=your_server_only_key_here
# The app origin used for Google OAuth callback (local default shown)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backblaze B2 private archive. Use the S3 endpoint shown on your bucket details.
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
# Shared server-only secret that lets the Vercel Workflow call the protected QA API
WORKFLOW_INTERNAL_TOKEN=

# Vercel Cron uses this bearer token to protect the automatic Blob cleanup endpoint.
CRON_SECRET=
# Soft planning limit for preflight only; Vercel usage/billing includes account-level averages and transfer.
BLOB_STORAGE_LIMIT_BYTES=1073741824
